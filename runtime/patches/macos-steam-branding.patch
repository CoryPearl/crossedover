Subject: macOS: Brand managed Steam hosts as crossedover Steam.

Opt-in only. Game and non-generic dialog titles retain their original names.

--- a/dlls/ntdll/unix/loader.c
+++ b/dlls/ntdll/unix/loader.c
@@ -646,6 +646,14 @@
     char *app_name = extract_exe_name(image_path);
     if (app_name)
     {
+        /* crossedover: brand Steam's macOS host, retaining every game's own name. */
+        if (getenv("CROSSEDOVER_STEAM_BRANDING") &&
+            (!strcasecmp(app_name, "steam.exe") || !strcasecmp(app_name, "steamwebhelper.exe")))
+        {
+            free(app_name);
+            app_name = strdup("crossedover Steam");
+            if (!app_name) return;
+        }
         char *preloader_path = create_preloader_link(*wineloader_path, app_name);
         if (preloader_path)
         {
