--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -1788,6 +1788,19 @@
 }
 
 
+/* Use the same per-monitor coordinate space for the client and ClipCursor.
+ * A previous full-client clip is the only rectangle we may follow. Explicit
+ * subrectangles, point capture, released capture and other windows stay alone. */
+static BOOL get_client_screen_clip(HWND hwnd, RECT *client, RECT *clip)
+{
+    UINT context = NtUserSetThreadDpiAwarenessContext(NTUSER_DPI_PER_MONITOR_AWARE_V2);
+    UINT dpi = NtUserGetWinMonitorDpi(hwnd, MDT_DEFAULT);
+    BOOL valid = NtUserGetClientRect(hwnd, client, dpi) && NtUserGetClipCursor(clip);
+    if (valid) NtUserMapWindowPoints(hwnd, 0, (POINT *)client, 2, dpi);
+    NtUserSetThreadDpiAwarenessContext(context);
+    return valid && !IsRectEmpty(client);
+}
+
 /***********************************************************************
  *              macdrv_window_frame_changed
  *
@@ -1799,7 +1812,8 @@
     RECT rect;
     UINT flags = SWP_NOACTIVATE | SWP_NOZORDER;
     int width, height;
-    BOOL being_dragged;
+    BOOL being_dragged, follow_clip = FALSE;
+    RECT old_client, old_clip;
 
     if (!hwnd) return;
     if (!(data = get_win_data(hwnd))) return;
@@ -1842,11 +1856,29 @@
     if (!(flags & SWP_NOSIZE) || !(flags & SWP_NOMOVE))
     {
         bool send_sizemove = !event->window_frame_changed.in_resize && !being_dragged && !event->window_frame_changed.skip_size_move_loop;
+        if (cursor_clipping_follows_window && hwnd == NtUserGetForegroundWindow() &&
+            get_client_screen_clip(hwnd, &old_client, &old_clip))
+            follow_clip = EqualRect(&old_client, &old_clip);
+
         if (send_sizemove)
             send_message(hwnd, WM_ENTERSIZEMOVE, 0, 0);
         NtUserSetRawWindowPos(hwnd, rect, flags, FALSE);
         if (send_sizemove)
             send_message(hwnd, WM_EXITSIZEMOVE, 0, 0);
+        if (follow_clip)
+        {
+            RECT client, clip;
+            /* WM_SIZE/WM_EXITSIZEMOVE may release or replace capture. Honor it.
+             * Otherwise stale screen coordinates clamp clicks to the old
+             * client after a native move/resize or fullscreen transition. */
+            if (hwnd == NtUserGetForegroundWindow() &&
+                get_client_screen_clip(hwnd, &client, &clip) && EqualRect(&clip, &old_clip))
+            {
+                UINT context = NtUserSetThreadDpiAwarenessContext(NTUSER_DPI_PER_MONITOR_AWARE_V2);
+                NtUserClipCursor(&client);
+                NtUserSetThreadDpiAwarenessContext(context);
+            }
+        }
     }
 }
 
